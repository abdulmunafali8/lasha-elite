rules_version='2';service cloud.firestore{match /databases/{d}/documents{
function admin(){return request.auth!=null&&exists(/databases/$(d)/documents/users/$(request.auth.uid))&&get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role=='superadmin';}
match /users/{uid}{allow read:if request.auth!=null&&(request.auth.uid==uid||admin());
allow create:if request.auth!=null&&request.auth.uid==uid&&request.resource.data.role in ['organizer','player','viewer'];
allow update:if request.auth!=null&&((request.auth.uid==uid&&request.resource.data.role==resource.data.role)||(admin()&&request.resource.data.role in ['organizer','player','viewer']));}
match /competitions/{id}{allow read:if true;
allow create:if request.auth!=null&&request.resource.data.ownerId==request.auth.uid&&get(/databases/$(d)/documents/users/$(request.auth.uid)).data.role in ['organizer','superadmin'];
allow update:if request.auth!=null&&(resource.data.ownerId==request.auth.uid||admin()||(request.resource.data.diff(resource.data).affectedKeys().hasOnly(['followers'])&&request.resource.data.followers.size()<=resource.data.followers.size()+1));
allow delete:if request.auth!=null&&resource.data.ownerId==request.auth.uid;
match /messages/{m}{allow read:if true;allow create:if request.auth!=null&&request.resource.data.uid==request.auth.uid&&request.resource.data.text.size()>0&&request.resource.data.text.size()<=500;allow delete:if request.auth!=null&&resource.data.uid==request.auth.uid;}
match /{sub}/{doc}{allow read:if true;allow write:if request.auth!=null&&(get(/databases/$(d)/documents/competitions/$(id)).data.ownerId==request.auth.uid||admin());}}
match /organizers/{id}{allow read:if true;allow write:if request.auth!=null&&(request.auth.uid==id||admin());}
match /activity/{id}{allow read:if true;allow create:if request.auth!=null;}
match /notifications/{id}{allow read:if true;allow create,delete:if admin();}
match /adminLogs/{id}{allow read,create:if admin();}}}
